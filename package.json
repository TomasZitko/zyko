{
  "name": "zyko",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @zyko/api --filter @zyko/web dev",
    "build": "pnpm --filter @zyko/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @zyko/contracts --filter @zyko/api test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @zyko/api db:generate",
    "db:migrate": "pnpm --filter @zyko/api db:migrate",
    "perf": "tsx scripts/perf.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
