# ── Core ──
NODE_ENV=development
DATABASE_URL=postgres://zyko:zyko@localhost:5432/zyko_dev
APP_ORIGIN=http://localhost:5173
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
STORAGE_DIR=.data/storage
# ── Hosting ──
SITES_DOMAIN=sites.localhost
SITES_PUBLIC_SCHEME=http
SITES_PUBLIC_PORT=:4100
DNS_MODE=system
# ── AI ── (mock = deterministic dev provider, no network)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# ── Billing ── (test = simulated checkout; refused when NODE_ENV=production)
BILLING_PROVIDER=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# ── Email ── (log = print to stdout)
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Zyko <no-reply@example.com>
# ── Process roles ──
WORKER_INLINE=true
# Production single-origin: serve the built web app from the API
# SERVE_WEB_DIST=apps/web/dist
