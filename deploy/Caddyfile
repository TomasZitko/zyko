{
	email {$ACME_EMAIL}
	# Certificates for customer domains are issued on demand, but only if the sites edge approves
	# the hostname (verified custom domain or existing platform subdomain).
	on_demand_tls {
		ask http://sites:4100/__zyko/tls-ask
	}
}

# SaaS application (UI + API) — separate origin from customer sites.
{$APP_HOST} {
	encode zstd gzip
	reverse_proxy api:4000
}

# Customer websites: platform subdomains, previews and verified custom domains.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy sites:4100 {
		header_up X-Forwarded-For {remote_host}
	}
}
