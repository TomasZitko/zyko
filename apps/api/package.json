    "@zyko/module-fixtures": "workspace:*",
    "@zyko/renderer": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.10.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": { "drizzle-kit": "^0.31.0" }
}
